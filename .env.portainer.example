# EcoVerse only. Generate .env.portainer with: node tools/deploy/prepare-env.mjs
# Import in the NEW ecoverse stack. Never reuse the VestGO .env.
ECOVERSE_IMAGE_TAG=latest
ECOVERSE_APP_URL=https://mosfet.com.br
ECOVERSE_CORS_ORIGIN=https://mosfet.com.br,https://www.mosfet.com.br
ECOVERSE_PROXY_NETWORK=rvproxy_npm_backend_network

# Generated independent secrets. Hex passwords avoid URL-encoding ambiguity.
ECOVERSE_POSTGRES_PASSWORD=
ECOVERSE_REDIS_PASSWORD=
ECOVERSE_MINIO_PASSWORD=
ECOVERSE_AUTH_SECRET=
ECOVERSE_JWT_SECRET=
ECOVERSE_JWT_REFRESH_SECRET=
ECOVERSE_2FA_KEY=

# First administrator: supply your email; remove both after first login.
ECOVERSE_ADMIN_EMAIL=
ECOVERSE_ADMIN_PASSWORD=

# Enable transactional email after filling these values.
ECOVERSE_EMAIL_ENABLED=false
ECOVERSE_SMTP_HOST=
ECOVERSE_SMTP_PORT=587
ECOVERSE_SMTP_SECURE=false
ECOVERSE_SMTP_USER=
ECOVERSE_SMTP_PASSWORD=
ECOVERSE_SMTP_FROM_ADDRESS=

ECOVERSE_GEOCODING_PROVIDER=nominatim
ECOVERSE_GEOCODING_EMAIL=
ECOVERSE_MAPBOX_PUBLIC_TOKEN=
ECOVERSE_MAPBOX_SECRET_TOKEN=
