# LOCAL DEVELOPMENT ONLY. Production: .env.portainer.example
# Domain / URLs
APP_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
STORAGE_PUBLIC_URL=http://localhost:9000
# Production configuration: .env.portainer.example

# App / web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
INTERNAL_API_URL=http://ecoverse-api:3001
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Auth
NEXTAUTH_SECRET=ecoverse-local-secret-change-me
AUTH_SECRET=ecoverse-local-secret-change-me

# API
PORT=3001
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
JWT_SECRET=ecoverse-jwt-secret
JWT_REFRESH_SECRET=ecoverse-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32-byte hex (64 chars). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# Email / SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@mosfet.com.br
SMTP_PASSWORD=
SMTP_FROM_NAME=EcoVerse
SMTP_FROM_ADDRESS=contato@mosfet.com.br
EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=60
ACCOUNT_DELETION_EXPIRES_MINUTES=60

# Temporary bootstrap admin - remove after initial provisioning
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=EcoVerse/1.0 (contato@mosfet.com.br)
GEOCODING_ACCEPT_LANGUAGE=pt-BR
GEOCODING_COUNTRY_CODES=br
GEOCODING_TIMEOUT_MS=5000
GEOCODING_EMAIL=contato@mosfet.com.br
GEOCODING_PROVIDER=nominatim
MAPBOX_SECRET_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Postgres
POSTGRES_DB=ecoverse
POSTGRES_USER=ecoverse
POSTGRES_PASSWORD=ecoverse
DATABASE_URL=postgresql://ecoverse:ecoverse@ecoverse-db:5432/ecoverse

# Redis
REDIS_PASSWORD=ecoverse_redis_password
REDIS_URL=redis://:ecoverse_redis_password@ecoverse-redis:6379

# Local API uploads (Docker mounts its own volume at /app/uploads)
UPLOADS_DIR=./uploads

# Production uses .env.portainer.example and ECOVERSE_* variables.

# Canais opcionais da ajuda (variaveis publicas de build do front-end)
# Deixe vazio ate definir os contatos oficiais.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
